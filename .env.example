# Con Edison credentials are configured in the web settings page.
# These legacy variables are optional one-time migration inputs. Remove them
# from Docker/Portainer after login.enc has been created.
# CONED_EMAIL=you@example.com
# CONED_PASSWORD=replace-with-password
# TOTP_SECRET=replace-with-base32-totp-secret

# Set to base64 only when CONED_PASSWORD contains a Base64-encoded password.
# CONED_PASSWORD_ENCODING=base64

# Collector behavior.
CONED_SOURCE_MODE=auto
CONED_POLLING_INTERVAL_MINUTES=7.5
CONED_DAILY_LOOKBACK_DAYS=30
CONED_DATA_PATH=data

# Optional: select a specific account; otherwise the first electric account is used.
# CONED_ACCOUNT_OVERRIDE=

# The longer variable names are accepted aliases:
# CONED_USERNAME=you@example.com
# CONED_TOTP_SECRET=replace-with-base32-totp-secret
